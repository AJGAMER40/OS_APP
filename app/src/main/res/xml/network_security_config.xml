<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ZeroVault operates strictly locally. Cleartext traffic is disabled globally. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
